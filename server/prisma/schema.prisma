generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  buyer
  seller
  admin

  @@map("user_role")
}

  enum ScamRisk {
    low
    high

    @@map("scam_risk")
  }

enum ListingStatus {
  verified
  under_review
  not_checked
  recalled
  removed

  @@map("listing_status")
}

enum EvidenceType {
  registration
  inspection
  service
  owner_cnic

  @@map("evidence_type")
}

enum EvidenceState {
  pending
  approved
  rejected

  @@map("evidence_state")
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique
  username            String         @unique
  fullName            String         @map("full_name")
  phone               String?
  passwordHash        String         @map("password_hash")
  role                Role           @default(buyer)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions            Session[]
  listings            Listing[]
  saved               SavedListing[]
  pushTokens          PushToken[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Listing {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  price         Int
  mileageKm     Int            @map("mileage_km")
  city          String
  about         String         @default("")
  bodyType      String?        @map("body_type")
  fuelType      String?        @map("fuel_type")
  status        ListingStatus  @default(not_checked)
  evidence      String[]
  evidenceDocs  EvidenceDocument[]
  saved         SavedListing[]
  photos        String[]
  conversations Conversation[]
  sellerId      String         @map("seller_id") @db.Uuid
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([sellerId])
  @@map("listings")
}

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  sellerId       String   @map("seller_id") @db.Uuid
  buyerArchived  Boolean  @default(false) @map("buyer_archived")
  sellerArchived Boolean  @default(false) @map("seller_archived")
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  scamRisk       String?
  scamWarning    String?    
  scamCheckedAt  DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model EvidenceDocument {
  id           String        @id @default(uuid()) @db.Uuid
  listingId    String        @map("listing_id") @db.Uuid
  type         EvidenceType
  fileName     String        @map("file_name")
  originalName String        @map("original_name")
  mimeType     String        @map("mime_type")
  state        EvidenceState @default(pending)
  reviewNote   String?       @map("review_note")
  reviewedAt   DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewedById String?       @map("reviewed_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, type])
  @@index([listingId])
  @@map("evidence_documents")
}

model SavedListing {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  listingId  String        @map("listing_id") @db.Uuid
  seenStatus ListingStatus @map("seen_status")
  seenPrice  Int           @map("seen_price")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("saved_listings")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}