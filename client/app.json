{
  "expo": {
    "name": "car-ledger",
    "slug": "car-ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "carledger",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.carledger",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3336362a-ac1c-4cfc-8762-89644b0ab97b"
      }
    }
  }
}
